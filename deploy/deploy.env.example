# Wzór `deploy/deploy.env` — ustawienia wdrożenia czytane przez `deploy/wdroz.sh`.
# Skopiuj do `deploy/deploy.env` i uzupełnij. ⚠ `deploy/deploy.env` jest w `.gitignore`:
# repo jest publiczne, a to są adresy konkretnego serwera.

# Kto i dokąd — ten sam adres, którym robisz `ssh`.
SERWER=uzytkownik@host

# Sieć Dockera, w której stoi reverse proxy (Caddy, nginx…). Proxy adresuje kontener po nazwie
# `walidator-prod:8139`, więc oba muszą być w tej samej sieci.
SIEC=nazwa-sieci

# Port na 127.0.0.1 serwera — WYŁĄCZNIE do sprawdzenia /api/zdrowie po podmianie kontenera.
# PORT_HOST=8140

# Plik env serwisu na serwerze (klucz OpenAI, AI_DO, HISTORIA_TOKEN…), względem katalogu domowego.
# Wzór: deploy/env.example.
# ENV_PLIK=walidator/prod.env
